 &ice_solo_nml
    date_init = 0, 0, 0, 0, 0, 0,
    calendar = 'no_calendar',
    months = 0,
    days   = 0,
    hours  = 0,
    minutes = 0,
    seconds = 0  /

 &MOM_input_nml
    output_directory = './',
    input_filename = 'n',
    restart_input_dir = 'INPUT/',
    restart_output_dir = 'RESTART/',
    parameter_filename = 'MOM_input', 'MOM_IS_input', 'MOM_IS_dynamic_input', 'MOM_override'  /

 &fms_nml
    clock_grain = 'ROUTINE',
    domains_stack_size = 200000,
    stack_size = 0  /

 &diag_manager_nml
    flush_nc_files = .true.  /
