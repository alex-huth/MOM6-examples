! MOM_IS_input -- Ice shelf non-dynamics parameters for the MPM front advance test.

! === module MOM_ice_shelf ===
ICE_SHELF = True
DYNAMIC_SHELF_MASS = True   ! ice thickness evolves with MPM
ADVECT_SHELF = False         ! MPM handles thickness advection

! Densities
DENSITY_ICE = 910.0         ! [kg m-3]
RHO_0 = 1028.0              ! [kg m-3]

! Ice thickness: read from NetCDF
ICE_PROFILE_CONFIG = "FILE"
ICE_THICKNESS_FILE = "MPM_IC.nc"
ICE_THICKNESS_VARNAME = "h_shelf"
ICE_AREA_VARNAME = "shelf_area"

! Surface mass balance: zero
ICE_SMB_CONFIG = "FILE"
ICE_SMB_FILE = "MPM_IC.nc"
ICE_SMB_VARNAME = "smb"

! (MPM settings are in MOM_IS_dynamic_input)
