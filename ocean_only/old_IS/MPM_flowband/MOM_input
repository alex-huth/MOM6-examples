! MOM_input for the MPM flow-band steady-state test.
!
! A 500 km x 75 km floating ice shelf in a Cartesian channel.
! Uniform thickness H = 500 m.  No basal friction.  Glen n = 3.
! The SSA Weertman solution gives a linearly increasing velocity for
! a uniform-thickness floating shelf with prescribed inflow.
!
! Seeding region: x in [0, 100 km] => hmask=3 (Dirichlet BC, ICE_BOUNDARY_CONFIG=CHANNEL).
! Free domain:   x in [100, 500 km] => particles evolve under SSA.
!
! Run DAYMAX = 150 yr (= 54750 days) for steady-state comparison.
! For a quick smoke-test run only a few velocity steps.

! === module MOM_domains ===
REENTRANT_X = False
REENTRANT_Y = False
NIGLOBAL = 20             ! 20 cells x 25 km = 500 km
NJGLOBAL = 3              ! 3 cells x 25 km = 75 km

! === module MOM_verticalGrid ===
NK = 1

! === module MOM ===
! The ice-shelf solo driver does not run ocean dynamics; NK and DT are
! placeholders satisfying MOM grid init.
DT = 86400.0              ! [s] dummy ocean timestep (1 day)

! === module MOM_fixed_initialization ===
INPUTDIR = "INPUT"

! === module MOM_grid_init ===
GRID_CONFIG = "cartesian"
AXIS_UNITS = "k"          ! kilometres
SOUTHLAT = 0.0            ! [km]
LENLAT = 75.0             ! [km]
WESTLON = 0.0             ! [km]
LENLON = 500.0            ! [km]
TOPO_CONFIG = "flat"
MAXIMUM_DEPTH = 1500.0    ! [m]  deep enough for floating ice
MINIMUM_DEPTH = 0.0       ! [m]

! === module MOM_ice_shelf (driver) ===
ICE_SHELF = True

! ICE_VELOCITY_TIMESTEP controls how often the SSA is solved and
! how far particles advance each call.
ICE_VELOCITY_TIMESTEP = 31536000.0  ! [s] = 1 yr

! Run to 150 years.
TIMEUNIT = 31536000.0     ! [s] 1 yr
DAYMAX = 150.0            ! [yr x TIMEUNIT]
RESTART_CONTROL = -1      ! no restart files

! === module MOM_ice_shelf_dyn ===
DYNAMIC_SHELF_MASS = True
ADVECT_SHELF = False      ! MPM handles thickness evolution

! Rheology
GLEN_EXPONENT = 3
ICE_VISCOSITY_COMPUTE = "MODEL"
NUMBER_OF_ICE_VISCOSITY_QUADRATURE_POINTS = 4
ICE_A_GLEN_CONFIG = "CONSTANT"
A_GLEN = 1.0e-25          ! [Pa^-n s^-1]  warm temperate ice

! Basal friction: none (floating shelf)
ICE_BASAL_FRICTION_CONFIG = "CONSTANT"
BASAL_FRICTION_COEFF = 0.0
BASAL_FRICTION_EXP = 1.0      ! exponent in sliding law (m = 1)

! Boundary and initial flow: analytic channel setup, no input files
ICE_BOUNDARY_CONFIG = "CHANNEL"
INPUT_VEL_ICE_SHELF = 6.342e-6 ! [m s-1] = 200 m yr-1 inflow velocity at x=0
INPUT_THICK_ICE_SHELF = 500.0 ! [m]

ICE_FLOW_CONFIG = "ZERO"      ! start from rest; SSA will establish velocity

! Ice profile: uniform 500 m shelf filling the whole domain
ICE_PROFILE_CONFIG = "CHANNEL"
SHELF_MAX_DRAFT = 500.0   ! [m]
SHELF_MIN_DRAFT = 500.0   ! [m]
FLAT_SHELF_WIDTH = 0.0    ! [km]
SHELF_SLOPE_SCALE = 0.0   ! [km]
SHELF_EDGE_POS_0 = 500.0  ! [km] ice front at the eastern wall

! Densities
DENSITY_ICE = 918.0       ! [kg m-3]
RHO_0 = 1028.0            ! [kg m-3] ocean

! Solver settings
CONJUGATE_GRADIENT_TOLERANCE = 1.0e-6
ICE_NONLINEAR_TOLERANCE = 1.0e-4
CONJUGATE_GRADIENT_MAXIT = 2000

! MPM settings
USE_MPM = False
MPM_N_PER_CELL = 4        ! 2x2 particles per cell
MPM_SPLIT_FACTOR = 2.0
MPM_FLIP_ALPHA = 1.0      ! pure FLIP

ENERGYSAVEDAYS = 365.0    ! [days ~> 1 yr] log energy annually
