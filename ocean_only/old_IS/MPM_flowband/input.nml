! Run-control namelist for the MPM flow-band steady-state test.
! Domain: 500 km x 75 km Cartesian channel, uniform floating ice shelf.
! The model integrates to t=150 yr; the SSA velocity should match the
! Weertman analytic solution to < 1% L2 error across the free domain.

 &ice_solo_nml
    date_init = 0, 0, 0, 0, 0, 0,
    calendar = 'no_calendar',
    months = 0,
    days   = 0,
    hours  = 0,
    minutes = 0,
    seconds = 0  /

 &MOM_input_nml
    output_directory = './',
    input_filename = 'n',
    restart_input_dir = 'INPUT/',
    restart_output_dir = 'RESTART/',
    parameter_filename = 'MOM_input', 'MOM_override'  /

 &fms_nml
    clock_grain = 'ROUTINE',
    domains_stack_size = 200000,
    stack_size = 0  /

 &diag_manager_nml
    flush_nc_files = .true.  /
